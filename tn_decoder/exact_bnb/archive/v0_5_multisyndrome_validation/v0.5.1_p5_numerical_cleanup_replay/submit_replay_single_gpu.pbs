#!/bin/bash
#PBS -q normal
#PBS -l select=1:ngpus=1:mpiprocs=1:ompthreads=1
#PBS -l walltime=08:00:00
#PBS -P 13004445
#PBS -j oe
#PBS -o output-p5-numerical-cleanup-replay.txt
#PBS -N bb72-p5-numclean

cd "${PBS_O_WORKDIR:-$(pwd)}" || exit 1
source ~/miniconda3/etc/profile.d/conda.sh
conda activate cudaqx-qec || exit 1

echo "===== START ====="
date
hostname
which python
python -c "import sys; print(sys.executable)"
python -c "import torch; print(torch.__version__); print(torch.cuda.is_available()); print(torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'NO GPU')"

python replay_p5_numerical_cleanup.py \
  --input-bundle input_bundle \
  --output-dir p5_numerical_cleanup_replay \
  --selection all \
  --save-arrays all \
  --progress-every 10

status=$?
echo "===== FINISHED ====="
date
echo "exit status = ${status}"
exit ${status}
